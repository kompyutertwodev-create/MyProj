# Application Configuration
NODE_ENV=development
PORT=3000
APP_NAME=IdentityPlatform
APP_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/identity_platform
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-16-characters
JWT_ISSUER=identity-platform
JWT_AUDIENCE=identity-platform-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=identity-platform-uploads
AWS_S3_REGION=us-east-1

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=identity-platform-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_PRETTY=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@identity-platform.com

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Feature Flags
FEATURE_REGISTRATION_ENABLED=true
FEATURE_SOCIAL_LOGIN_ENABLED=false
FEATURE_MULTI_TENANT_ENABLED=false
