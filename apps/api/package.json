{
  "name": "@workspace/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --outfile=dist/main.js --format=esm --external:pino-pretty --external:thread-stream --external:argon2",
    "start": "node --enable-source-maps ./dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@aws-sdk/s3-request-presigner": "^3.1084.0",
    "@opentelemetry/api": "^1.9.1",
    "@workspace/contracts": "workspace:*",
    "@workspace/iam": "workspace:*",
    "@workspace/kernel": "workspace:*",
    "@workspace/platform": "workspace:*",
    "argon2": "^0.41.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "catalog:",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^2.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.1",
    "pino": "catalog:",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}
